# The Firebase web config for the shared project is committed in src/net/firebaseApp.ts, so no
# variables are needed to build or deploy. Set these only to point a fork at your own Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Set to 1 to run in single-device local mode with no network (useful for testing the camera alone).
VITE_LOCAL_MODE=
