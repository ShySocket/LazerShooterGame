{
  "name": "lazer-shooter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:http": "VITE_HTTPS=0 vite --host",
    "dev:local": "VITE_LOCAL_MODE=1 VITE_HTTPS=0 vite --host",
    "replay": "node --import ./tests/register.mjs scripts/replay-feedback.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "tsc -p tsconfig.test.json && node --import ./tests/register.mjs --test tests/*.test.ts",
    "sim": "node --import ./tests/register.mjs tests/sim/report.ts",
    "preview": "vite preview --host",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@vladmandic/human": "^3.3.6",
    "firebase": "^12.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "engines": {
    "node": ">=22.15"
  }
}
