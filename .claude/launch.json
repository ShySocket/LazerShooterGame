{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "url": "https://localhost:5173"
    },
    {
      "name": "dev-http",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:http"
      ],
      "port": 5174,
      "autoPort": true
    },
    {
      "name": "dev-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:local"
      ],
      "port": 5173,
      "autoPort": true
    }
  ]
}
